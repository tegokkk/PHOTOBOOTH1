# === DATABASE ===
# Neon PostgreSQL (https://console.neon.tech) — GRATIS, stabil untuk Vercel serverless
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Set true untuk transaction pooler (Neon/Supabase pooler)
PRISMA_PGBOUNCER="true"

# === CLOUDFLARE R2 STORAGE ===
# Buat bucket di: Cloudflare Dashboard → R2 → Create bucket
# Buat API Token di: Cloudflare Dashboard → R2 → Manage R2 API Tokens
CF_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="photobooth-photos"
# R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"  # Opsional jika bucket public

# === AUTH ===
JWT_SECRET="generate_a_secure_random_string_with_at_least_32_characters"

# === SERVER ===
FRONTEND_URL="https://photobooth.example.com"
NODE_ENV="production"
TRUST_PROXY="1"
PORT=5000

# === MISC ===
SEED_ADMIN_PASSWORD="set_this_only_for_a_one_time_seed"
FRAME_ASSET_COLUMNS_ENABLED="true"
GUEST_PHOTO_RETENTION_HOURS="168"
ALLOW_PUBLIC_REGISTRATION="false"
