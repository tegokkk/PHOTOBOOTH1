DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/photobooth?schema=public"
# Set true for a transaction pooler such as Supabase/Neon pooler.
PRISMA_PGBOUNCER="true"
JWT_SECRET="generate_a_secure_random_string_with_at_least_32_characters"
FRONTEND_URL="https://photobooth.example.com"
UPLOAD_DIR="/var/lib/photobooth/uploads"
NODE_ENV="production"
TRUST_PROXY="1"
SEED_ADMIN_PASSWORD="set_this_only_for_a_one_time_seed"
PORT=5000
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="server_only_service_role_key"
FRAME_STORAGE_BUCKET="frames"
FRAME_MASTER_DIR="../FRAME/masters"
FRAME_ASSET_COLUMNS_ENABLED="false"
GUEST_PHOTO_RETENTION_HOURS="168"
ALLOW_PUBLIC_REGISTRATION="false"
