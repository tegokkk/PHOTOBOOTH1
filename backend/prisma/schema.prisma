generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Frame {
  id             String    @id @default(uuid())
  name           String
  category       String?
  imageUrl       String    @map("image_url")
  cssPlaceholder String?   @map("css_placeholder")
  width          Int?
  height         Int?
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  isPremium      Boolean   @default(false) @map("is_premium")
  designCredit   String?   @map("design_credit")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  photos Photo[]

  @@map("frames")
}

model Photo {
  id                String    @id @default(uuid())
  userId            String?   @map("user_id")
  frameId           String?   @map("frame_id")
  originalImageUrl  String    @map("original_image_url")
  compositeImageUrl String    @map("composite_image_url")
  width             Int?
  height            Int?
  fileSize          Int?      @map("file_size")
  metadata          String?   // JSON string
  source            String?
  isPublic          Boolean   @default(false) @map("is_public")
  downloadCount     Int       @default(0) @map("download_count")
  shareCount        Int       @default(0) @map("share_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  frame Frame? @relation(fields: [frameId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@map("photos")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  fullName          String?   @map("full_name")
  profilePictureUrl String?   @map("profile_picture_url")
  isAdmin           Boolean   @default(false) @map("is_admin")
  isActive          Boolean   @default(true) @map("is_active")
  lastLogin         DateTime? @map("last_login")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  photos            Photo[]

  @@map("users")
}
