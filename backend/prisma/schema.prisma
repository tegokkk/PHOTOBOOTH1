generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Frame {
  id             String    @id @default(uuid())
  name           String
  category       String?
  imageUrl       String    @map("image_url")
  cssPlaceholder String?   @map("css_placeholder")
  width          Int?
  height         Int?
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  isPremium      Boolean   @default(false) @map("is_premium")
  designCredit   String?   @map("design_credit")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  photos Photo[]
  slots  FrameSlot[]

  @@index([category])
  @@index([isActive])
  @@index([isPremium])
  @@map("frames")
}

model Photo {
  id                String    @id @default(uuid())
  userId            String?   @map("user_id")
  frameId           String?   @map("frame_id")
  originalImageUrl  String    @map("original_image_url")
  compositeImageUrl String    @map("composite_image_url")
  width             Int?
  height            Int?
  fileSize          Int?      @map("file_size")
  metadata          String?   // JSON string
  guestAccessTokenHash String? @map("guest_access_token_hash")
  source            String?
  isPublic          Boolean   @default(false) @map("is_public")
  downloadCount     Int       @default(0) @map("download_count")
  shareCount        Int       @default(0) @map("share_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  frame      Frame?      @relation(fields: [frameId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  shareLinks ShareLink[]

  @@index([userId])
  @@index([frameId])
  @@index([createdAt])
  @@index([isPublic])
  @@index([deletedAt])
  @@map("photos")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  fullName          String?   @map("full_name")
  profilePictureUrl String?   @map("profile_picture_url")
  isAdmin           Boolean   @default(false) @map("is_admin")
  isActive          Boolean   @default(true) @map("is_active")
  lastLogin         DateTime? @map("last_login")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  
  photos            Photo[]
  preferences       UserPreference?
  auditLogs         AuditLog[]
  shareLinks        ShareLink[]

  @@map("users")
}

model FrameSlot {
  id          String   @id @default(uuid())
  frameId     String   @map("frame_id")
  x           Float    // Koordinat X normalisasi 0-1
  y           Float    // Koordinat Y normalisasi 0-1
  width       Float    // Lebar normalisasi 0-1
  height      Float    // Tinggi normalisasi 0-1
  rotation    Float    @default(0) // Derajat rotasi
  zIndex      Int      @default(0) @map("z_index")
  
  frame       Frame    @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@index([frameId])
  @@map("frame_slots")
}

model ShareLink {
  id          String   @id @default(uuid())
  photoId     String   @map("photo_id")
  createdById String?  @map("created_by_id")
  token       String   @unique // URL token
  password    String?  // Optional password (hashed)
  expiresAt   DateTime? @map("expires_at")
  accessCount Int      @default(0) @map("access_count")
  createdAt   DateTime @default(now()) @map("created_at")
  
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([photoId])
  @@index([token])
  @@map("share_links")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String   // misal: 'LOGIN_FAILED', 'PHOTO_DELETED'
  details     String?  // JSON string
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model UserPreference {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  receiveEmails    Boolean  @default(true) @map("receive_emails")
  highQualityExport Boolean @default(true) @map("high_quality_export")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
