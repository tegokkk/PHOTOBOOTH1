generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Frame {
  id             String    @id @default(uuid())
  name           String
  category       String?
  imageUrl       String    @map("image_url")
  previewImageUrl String?  @map("preview_image_url")
  masterImageUrl  String?   @map("master_image_url")
  cssPlaceholder String?   @map("css_placeholder")
  width          Int?
  height         Int?
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  isPremium      Boolean   @default(false) @map("is_premium")
  designCredit   String?   @map("design_credit")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  photos Photo[]
  slots  FrameSlot[]

  @@index([category])
  @@index([isActive])
  @@index([isPremium])
  @@map("frames")
}

model Photo {
  id                String    @id @default(uuid())
  frameId           String?   @map("frame_id")
  originalImageUrl  String    @map("original_image_url")
  compositeImageUrl String    @map("composite_image_url")
  width             Int?
  height            Int?
  fileSize          Int?      @map("file_size")
  metadata          String?   // JSON string
  guestAccessTokenHash String? @map("guest_access_token_hash")
  idempotencyKey      String? @unique @map("idempotency_key")
  source            String?
  isPublic          Boolean   @default(false) @map("is_public")
  downloadCount     Int       @default(0) @map("download_count")
  shareCount        Int       @default(0) @map("share_count")
  createdAt         DateTime  @default(now()) @map("created_at")
  deletedAt         DateTime? @map("deleted_at")

  frame      Frame?      @relation(fields: [frameId], references: [id])
  shareLinks ShareLink[]

  @@index([frameId])
  @@index([createdAt])
  @@index([isPublic])
  @@index([deletedAt])
  @@map("photos")
}


model FrameSlot {
  id          String   @id @default(uuid())
  frameId     String   @map("frame_id")
  x           Float    // Koordinat X normalisasi 0-1
  y           Float    // Koordinat Y normalisasi 0-1
  width       Float    // Lebar normalisasi 0-1
  height      Float    // Tinggi normalisasi 0-1
  rotation    Float    @default(0) // Derajat rotasi
  zIndex      Int      @default(0) @map("z_index")
  
  frame       Frame    @relation(fields: [frameId], references: [id], onDelete: Cascade)

  @@index([frameId])
  @@map("frame_slots")
}

model ShareLink {
  id          String   @id @default(uuid())
  photoId     String   @map("photo_id")
  token       String   @unique // URL token
  password    String?  // Optional password (hashed)
  expiresAt   DateTime? @map("expires_at")
  accessCount Int      @default(0) @map("access_count")
  createdAt   DateTime @default(now()) @map("created_at")
  
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@index([token])
  @@map("share_links")
}


model PrintJob {
  id           String   @id @default(uuid())
  sessionId    String?  @map("session_id")
  photoId      String?  @map("photo_id")
  frameName    String   @map("frame_name")
  copies       Int      @default(1)
  status       String   @default("queued") // queued, printing, completed, failed
  errorMessage String?  @map("error_message")
  attempts     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("print_jobs")
}
